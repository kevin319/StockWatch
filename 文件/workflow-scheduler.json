    { "from": "fetch-news", "to": "call-llm" },
    { "from": "call-llm", "to": "upsert-summary" }
  ],
  "cards": [
    { "dot": "cyan", "title": "每日備份", "items": ["03:00 執行 pg_dump 邏輯備份", "驗證 dump 完整性後 gzip 壓縮", "自動輪替保留最近 30 份"] },
    { "dot": "violet", "title": "AI 摘要更新", "items": ["07:00 對所有自選股逐支更新", "依市場選擇 Finnhub 或 yfinance 蒐集資料", "DeepSeek LLM 產生 200 字摘要"] }
  ]
